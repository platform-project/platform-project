CACHE MANIFEST
# 2025-03-09: v1

# Explicitly cached 'master entries'.
CACHE:
assets/css/style.css
assets/icon/favicon.png
assets/images/*
assets/sounds/*
assets/js/todoly.js
cache.html
wallpaper.html
offline.html
index.html

# Resources that require the user to be online.
NETWORK:
*
index.php
index.html
browser.html
offline.html
splash.html
#/myapi

# static.html will be server if main.py is inaccessible
# offline.png will be served in place of all images in images/large/
# offline.html will be served in place of all other .html files
FALLBACK:
#/main.py /static.html
#images/large/ images/offline.png
*.html offline.html